# M1 local development. Production requires HTTPS/Caddy and full release hardening.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=./data/navloom.db

# One-time admin initialization via CLI only:
# NAVLOOM_ADMIN_USERNAME, NAVLOOM_ADMIN_PASSWORD, NAVLOOM_HOME_PASSPHRASE
# Enter these interactively; never commit real passwords, tokens or database files.


# M3 optional encrypted prepared-task vault:
# NAVLOOM_INSTALL_KEY must be 32 cryptographically random bytes as base64url
# (43 characters), supplied by an external secret/env system. DO NOT add the
# value to Git, logs, Compose command arguments, or this example.
# If absent, encrypted install draft saving fails closed with HTTP 503.
# Saving a prepared draft NEVER triggers Agent Docker Compose execution.
