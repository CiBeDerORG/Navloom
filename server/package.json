{
  "name": "@navloom/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:init": "tsx src/cli/init-admin.ts"
  },
  "dependencies": {
    "@navloom/contracts": "0.1.0",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.43.1",
    "fastify": "^5.3.2",
    "zod": "^3.24.2",
    "@fastify/websocket": "^11.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "@types/ws": "^8.18.1"
  }
}
